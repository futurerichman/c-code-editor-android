<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1e1e1e">

    <TextureView
        android:id="@+id/vvBgFull"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:background="@android:color/transparent"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2d2d30"
            android:paddingHorizontal="8dp"
            android:paddingVertical="6dp"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/btnFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="6dp"
                android:text="文件"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:paddingHorizontal="10dp"
                android:minWidth="56dp" />

            <Button
                android:id="@+id/btnRun"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="运行"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg_run"
                android:paddingHorizontal="10dp"
                android:minWidth="56dp" />

            <Button
                android:id="@+id/btnStepToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="步过"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:paddingHorizontal="10dp"
                android:minWidth="56dp" />

            <TextView
                android:id="@+id/btnMore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:text="⋮"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvFile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="untitled.c"
                android:textSize="13sp"
                android:textColor="#9cdcfe"
                android:gravity="end"
                android:ellipsize="end"
                android:maxLines="1" />

            <TextView
                android:id="@+id/btnToggleToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="收起"
                android:textSize="12sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="6dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/toolbarCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#2d2d30"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnShowToolbar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▼ 展开工具栏"
                android:textSize="12sp"
                android:textColor="#9cdcfe"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/editorContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/ivBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="代码区背景图" />

            <TextureView
                android:id="@+id/vvBg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone" />

            <com.ccode.mintest.CCodeEditText
                android:id="@+id/etCode"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:textColor="#d4d4d4"
                android:textColorHint="#6a6a6a"
                android:textSize="14sp"
                android:typeface="monospace"
                android:gravity="top|start"
                android:paddingStart="54dp"
                android:paddingEnd="10dp"
                android:paddingVertical="8dp"
                android:hint="在这里输入 C 语言代码…"
                android:inputType="textMultiLine"
                android:scrollbars="vertical"
                android:overScrollMode="ifContentScrolls" />

            <com.ccode.mintest.CLineNumberView
                android:id="@+id/lineNumbers"
                android:layout_width="44dp"
                android:layout_height="match_parent"
                android:layout_gravity="left|top" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/console"
            android:layout_width="match_parent"
            android:layout_height="180dp"
            android:orientation="vertical"
            android:background="#0d0d0d">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1a1a1a"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:text="控制台"
                    android:textSize="12sp"
                    android:textColor="#8a8a8a" />

                <TextView
                    android:id="@+id/btnToggleConsole"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:text="收起"
                    android:textSize="12sp"
                    android:textColor="#9cdcfe"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <ScrollView
                android:id="@+id/scConsole"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/tvConsole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:typeface="monospace"
                    android:textColor="#cccccc"
                    android:textIsSelectable="true"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="6dp" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/inputBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1a1a1a"
                android:padding="4dp"
                android:visibility="gone">

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="#252526"
                    android:textColor="#d4d4d4"
                    android:textColorHint="#6a6a6a"
                    android:textSize="14sp"
                    android:typeface="monospace"
                    android:singleLine="true"
                    android:imeOptions="actionSend"
                    android:inputType="text"
                    android:hint="程序等待输入（scanf）…" />

                <Button
                    android:id="@+id/btnSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:text="发送"
                    android:textSize="14sp"
                    android:textColor="#ffffff"
                    android:background="@drawable/btn_bg_run"
                    android:minWidth="48dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/consoleCollapsed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#1a1a1a"
            android:paddingHorizontal="8dp"
            android:paddingVertical="3dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/btnShowConsole"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="▲ 展开控制台"
                android:textSize="12sp"
                android:textColor="#9cdcfe"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/debugBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#243b3b"
            android:padding="4dp"
            android:gravity="center_vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/btnStep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="步过"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg_run"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/btnContinue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="继续"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg_run"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/btnBreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="断点"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:minWidth="48dp" />

            <Button
                android:id="@+id/btnStopDebug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="停止"
                android:textSize="14sp"
                android:textColor="#ffffff"
                android:background="@drawable/btn_bg"
                android:minWidth="48dp" />

            <TextView
                android:id="@+id/tvDebugStatus"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:textSize="12sp"
                android:textColor="#9cdcfe"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <HorizontalScrollView
            android:id="@+id/symbolBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#2d2d30"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/symbolRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingVertical="4dp"
                android:paddingStart="4dp"
                android:paddingEnd="4dp" />
        </HorizontalScrollView>
    </LinearLayout>
</FrameLayout>
